{
  "description": "Keeps the main thread in the orchestrator role. Blocks Fable workers, warns when a worker model is missing or unknown, holds workers to verified reporting, and lets an optional local classifier hint when to delegate and pick the worker model.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${ORCHESTRATOR_PYTHON:-python3}\" \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${ORCHESTRATOR_PYTHON:-python3}\" \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"${ORCHESTRATOR_PYTHON:-python3}\" \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" agent-call",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|Glob|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${ORCHESTRATOR_PYTHON:-python3}\" \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" tool-call",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${ORCHESTRATOR_PYTHON:-python3}\" \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
